# PLANTILLA. Copia este archivo a "keystore.properties" (mismo directorio raíz) y
# rellena con tus datos para FIRMAR builds de release en LOCAL.
#
# El archivo real keystore.properties está en .gitignore y NO debe subirse al repo.
# En CI (GitHub Actions) NO se usa este fichero: las credenciales llegan por
# variables de entorno desde los Secrets (ver .github/workflows/release-aab.yml).

storeFile=guardianes-upload.jks
storePassword=TU_STORE_PASSWORD
keyAlias=guardianes
keyPassword=TU_KEY_PASSWORD
